{
  "name": "lapriere-website",
  "type": "module",
  "version": "0.0.1",
  "imports": {
    "#js/*": {
      "development": "./src/*.development.js",
      "default": "./src/*.js"
    }
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm-run-all build:license build:astro",
    "build:license": "license-checker-rseidelsohn --plainVertical --production --out ./public/LICENSES.txt",
    "build:astro": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm-run-all --parallel check:stylelint check:eslint check:oxlint check:astro check:tsc",
    "check:tsc": "tsc --noEmit",
    "check:astro": "astro check",
    "check:stylelint": "stylelint '**/*.{html,astro,css,scss}'",
    "check:eslint": "eslint .",
    "check:oxlint": "oxlint --deny-warnings .",
    "fix": "npm-run-all fix:stylelint fix:eslint",
    "fix:stylelint": "stylelint --fix '**/*.{html,astro,css,scss}'",
    "fix:eslint": "eslint --fix .",
    "update:npm": "ncu --removeRange -x @totto/*",
    "update:jsr": "ncu --removeRange @totto/* -r https://npm.jsr.io/"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/partytown": "2.1.9",
    "@astrojs/sitemap": "3.7.6",
    "@astrojs/tailwind": "6.0.2",
    "@astrojs/ts-plugin": "1.11.0",
    "@builder.io/qwik": "1.20.4",
    "@iconify-json/devicon": "1.2.84",
    "@iconify-json/material-symbols": "1.2.101",
    "@iconify-json/material-symbols-light": "1.2.102",
    "@iconify/tailwind": "1.2.0",
    "@qwikdev/astro": "0.8.3",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgx/core": "1.0.2",
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/typography": "0.5.20",
    "@totto/lib": "npm:@jsr/totto__lib@0.2.1",
    "@types/fs-extra": "11.0.4",
    "@types/js-cookie": "3.0.6",
    "@types/node": "^26.6.6",
    "astro": "7.4.13",
    "caniuse-lite": "^1.0.30001826",
    "cva": "beta",
    "daisyui": "5.8.2",
    "htmlrewriter": "0.0.13",
    "js-cookie": "3.0.8",
    "jsr": "0.14.3",
    "license-checker-rseidelsohn": "5.0.1",
    "npm-run-all2": "9.1.0",
    "postcss-html": "2.0.1",
    "rehype-external-links": "3.0.0",
    "remeda": "2.62.2",
    "sass": "1.108.2",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "unplugin-icons": "24.0.0",
    "valibot": "1.5.0",
    "vite": "8.3.8",
    "wrangler": "4.166.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@totto2727/oxlint": "^0.2.0",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "expect-axe-playwright": "4.1.3",
    "npm-check-updates": "23.1.1",
    "oxlint": "^1.94.0",
    "reg-suit": "0.14.5",
    "stylelint": "18.1.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "41.1.0",
    "stylelint-config-standard-scss": "18.0.0",
    "typescript-eslint": "8.73.0"
  }
}
